# Web login password — leave unset (and keep auth disabled) to open
# the UI without a password on a trusted LAN; set it to enable the gate.
# VRCX_WEB_PASSWORD=change-me
# VRCX_WEB_AUTH_DISABLED=true

# Remote sync PostgreSQL (bring your own; desktop VRCX-0 must target the
# same server in its Settings -> Data Sync).
VRCX_SYNC_HOST=192.168.66.33
VRCX_SYNC_PORT=5432
VRCX_SYNC_USER=vrcx
VRCX_SYNC_PASSWORD=change-me
VRCX_SYNC_DATABASE=vrcx

# Optional: allow unencrypted PG connections on trusted LANs (default true).
# VRCX_SYNC_ALLOW_PLAINTEXT=true
# Optional: sync cadence seconds (default 15 in compose).
# VRCX_SYNC_INTERVAL_SEC=15
# Optional: realtime mode auto|always (default auto — the server pauses
# its own VRChat session while the desktop device is active).
# VRCX_CLOUD_REALTIME_MODE=auto
