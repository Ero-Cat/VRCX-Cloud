# Remote sync PostgreSQL (bring your own; desktop VRCX-0 must target the
# same server in its Settings -> Data Sync). These two are all you need:
VRCX_CLOUD_SYNC_HOST=192.168.66.33
VRCX_CLOUD_SYNC_PASSWORD=change-me

# Everything below is optional — uncomment to override the default shown.
# VRCX_CLOUD_ADMIN_PASSWORD=change-me-too   # browser 2nd-factor gate (unlock once per browser)
# VRCX_CLOUD_SYNC_PORT=5432
# VRCX_CLOUD_SYNC_USER=vrcx
# VRCX_CLOUD_SYNC_DATABASE=vrcx
# VRCX_CLOUD_SYNC_INTERVAL_SEC=15
# VRCX_CLOUD_SYNC_ALLOW_PLAINTEXT=false   # only if your PostgreSQL requires TLS
# VRCX_CLOUD_REALTIME_MODE=auto           # auto | always
